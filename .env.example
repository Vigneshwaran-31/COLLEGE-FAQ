# ===============================================================
# DUM DUM Group of Institution - College FAQ Agent Configuration
# ===============================================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Resilient Fallbacks if gemini-2.5-flash is not available for new users:
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# College Details
COLLEGE_NAME="DUM DUM Group of Institution"
COLLEGE_TAGLINE="Excellence in Education, Research & Integrity"
COLLEGE_CODE="DGD-2026"

# Security & Sessions
SESSION_SECRET=change-this-to-a-secure-random-key-in-production
PASSWORD_SALT=dumdum-institution-salt-2026

# Storage Paths
DATABASE_PATH=data/college_faq.db
UPLOADS_DIR=data/uploads
GENERATED_DOCS_DIR=data/generated_docs

# Email Service Configuration (Human-in-the-Loop Enforced)
# Leave SMTP_ENABLED=False if SMTP is not configured
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=office@dumdumgroup.edu
SMTP_PASSWORD=
SMTP_FROM_EMAIL=office@dumdumgroup.edu

# Document Upload Limits
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg
